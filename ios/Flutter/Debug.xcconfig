#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"
#include "Rust.xcconfig"

// Fast Rust builds for iteration; see Rust.xcconfig.
RUST_PROFILE = release-dev

// Running on a physical device needs a signing team, which is personal to each
// developer — committing one makes everyone else's debug build fail against an
// Apple team they don't belong to. Put yours in Flutter/Local.xcconfig, which is
// gitignored:
//
//     DEVELOPMENT_TEAM = ABCDE12345
//     PRODUCT_BUNDLE_IDENTIFIER = org.fedimint.ecashapp.yourname
//
// A free personal Apple ID works; the bundle id has to be unique to your team.
// Without that file the build still configures, and Xcode reports the missing
// team when you try to run on a device.
PRODUCT_BUNDLE_IDENTIFIER = org.fedimint.ecashapp

#include? "Local.xcconfig"
